{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "zandani",
  "compatibility_date": "2026-09-15",
  "main": "./worker.js",
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {},
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/google4a7d26b466f41330.html",
      "/google4a7d26b466f41330",
      "/968a6d115d3240a3acbc3448c398978d.txt",
      "/api/subscribe",
      "/api/unsubscribe",
      "/api/github",
      "/api/scheduler/*"
    ]
  }
}
